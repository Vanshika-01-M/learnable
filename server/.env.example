# Copy this file to server/.env and fill in your key. server/.env is not committed to git.

# Free key from https://console.groq.com/keys (needed only for "Make sentence")
GROQ_API_KEY=

# Optional: another Groq model your account can use, e.g. openai/gpt-oss-20b (a little faster)
GROQ_MODEL=openai/gpt-oss-120b
